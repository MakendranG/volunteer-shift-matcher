# ---------------------------------------------------------------------------
# Example environment configuration for volunteer-shift-matcher.
# Copy this file to `.env` and fill in your own values. NEVER commit `.env`.
# There are NO real secrets in this file.
# ---------------------------------------------------------------------------

# --- Amazon Bedrock (default model provider for the Strands Agents SDK) ---
# The Strands agent uses Amazon Bedrock (Claude Sonnet 4) by default.
# Provide AWS credentials via ONE of the standard mechanisms:
#   1. These environment variables, or
#   2. `aws configure` (shared credentials file), or
#   3. An IAM role (if running on EC2/ECS/Lambda).

AWS_ACCESS_KEY_ID=your-access-key-id-here
AWS_SECRET_ACCESS_KEY=your-secret-access-key-here
# AWS_SESSION_TOKEN=optional-session-token-here

# AWS region that has Bedrock model access enabled.
AWS_REGION=us-west-2

# Optional: override the Bedrock model id the agent uses.
# BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6

# Optional alternative: a Bedrock bearer token instead of AWS keys.
# AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key-here
